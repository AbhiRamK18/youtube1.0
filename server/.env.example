DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0

# Paste a single-line Firebase Admin service-account JSON value here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Use a newly generated random secret of at least 32 characters.
AUTH_SECURITY_SECRET=
TRUSTED_DEVICE_DAYS=30
AUTH_COOKIE_SAMESITE=Lax
# Comma-separated Google sign-in email addresses allowed to use /admin/comments.
ADMIN_EMAILS=youtubesmtp@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=

# Razorpay Test Mode credentials. Never put these secrets in the frontend env.
RAZORPAY_KEY_ID=rzp_test_Tu9j99MwmTwjZb
RAZORPAY_KEY_SECRET=rm8v1kwMuPkfbM2iNKU71BDk
# Generate a separate random secret of at least 32 characters for signed stream tickets.
STREAM_TICKET_SECRET=ebe3294cf4afe56cf8a1775546c5287e83a8d508bf18608669acd90aeb4ee603
 
# Login location uses browser permission and OpenStreetMap Nominatim reverse geocoding.
# Configure abusive terms for the languages this community uses, and known malicious domains.
# Values are comma-separated; subdomains of blocked domains are blocked too.
COMMENT_ABUSIVE_WORDS=
COMMENT_BLOCKED_DOMAINS=
